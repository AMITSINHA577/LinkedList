package linkedList;

public class TestingAllCode {

	NodeTest<Integer> head;

	private void insertATHead(int data) {
		// TODO Auto-generated method stub
		NodeTest<Integer> newNode = new NodeTest<Integer>(data);

		if (head == null) {
			head = newNode;
			return;
		}
		
		newNode.next = head;
		head = newNode;

	}

	private void pintNodeData() {
		// TODO Auto-generated method stub

		NodeTest<Integer> temp = head;
		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}

	}

	public static void main(String[] args) {

		TestingAllCode obj1 = new TestingAllCode();
		obj1.insertATHead(10);
		obj1.pintNodeData();

	}

}

class NodeTest<T> {
	T data;
	NodeTest next;

	public NodeTest() {
		this.next = null;
	}

	public NodeTest(T data) {
		this.data = data;
		this.next = null;
	}
}