class doublyNode<T> {

	T data;
	doublyNode<T> next;
	doublyNode<T> prev;

	public doublyNode() {
		// TODO Auto-generated constructor stub
		this.next = null;
		this.prev = null;
	}

	public void doublyNod(T data) {
		// TODO Auto-generated method stub
		this.data = data;
		this.next = null;
		this.prev = null;
	}
}
