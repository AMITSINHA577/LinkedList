package LinkedList_30_Q;

public class DeleteNodeByValue {

	nodeLinks<Integer> head;

	public void insertData(int data) {
		nodeLinks<Integer> newNodeData = new nodeLinks<Integer>(data);
		if (head == null) {
			head = newNodeData;
			return;
		}

		newNodeData.next = head;
		head = newNodeData;
	}

	public void printData() {
		nodeLinks<Integer> temp = head;

		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}
	}

	public void deleteByValue(int valueD) {

		nodeLinks<Integer> temp = head;
		nodeLinks<Integer> prev = null;

		while (temp.next != null && temp.data != valueD) {
			prev = temp;
			temp = temp.next;
		}

		prev = temp.next;

	}

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		DeleteNodeByValue obj1 = new DeleteNodeByValue();
		obj1.insertData(10);
		obj1.insertData(20);
		obj1.insertData(30);
		System.out.println("Wellcome");
		obj1.printData();

	}

}
