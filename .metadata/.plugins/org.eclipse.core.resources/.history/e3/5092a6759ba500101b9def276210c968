package linkedList;

public class insertAtAnyPos {

	DNode<Integer> head; // Pointer to the first node of the list

//	Inserts a new node at the beginning (head) of the doubly linked list.
	private void insertInToHead(int data) {

		DNode<Integer> newNode = new DNode<Integer>(data);

		// Case 1: If the list is empty
		if (head == null) {
			head = newNode;
			return;
		}

		// Case 2: If list already has nodes
		newNode.next = head; // point new node's next to current head
		head.prev = newNode; // update old head's prev to new node
		head = newNode; // update head to new node
	}

//	Inserts a new node at the end (tail) of the doubly linked list.
	private void insertInToTail(int data) {

		DNode<Integer> newNode = new DNode<Integer>(data);
		// Case 1: Empty list
		if (head == null) {
			head = newNode;
			return;
		}

		// Case 2: Traverse to the last node
		DNode<Integer> temp = head;
		while (temp.next != null) {
			temp = temp.next;
		}

		// Connect new node to the end
		temp.next = newNode;
		newNode.prev = temp;

	}

	private void printData() {
		DNode<Integer> temp = head;
		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}

	}

	public static void main(String[] args) {

		completeDoublyCode list = new completeDoublyCode();

		System.out.println("Inserting into head...");
		list.insertInToHead(10);
		list.insertInToHead(20);
		list.insertInToHead(30);
		list.insertInToHead(40);

		list.printData();

		System.out.println("Inserting into tail...");
		list.insertInToTail(90);
		list.insertInToTail(100);
		list.printData();

	}

}

/**
 * DNode represents a single node in the doubly linked list. Each node contains
 * data, a reference to the next node, and a reference to the previous node.
 */

class DNode<T> {
	T data;
	DNode<T> next;
	DNode<T> prev;

	// Default constructor
	public DNode() {
		this.next = null;
		this.prev = null;
	}

	// Parameterized constructor
	public DNode(T data) {
		this.data = data;
		this.next = null;
		this.prev = null;

	}
}
