package linkedList;

public class deleteAtAnyPositionData {

	Node<Integer> head;

	public void insertInToHead(int data) {

		Node<Integer> newNode = new Node(data);

		if (head == null) {
			head = newNode;
			return;
		}

		newNode.next = head;
		head = newNode;
	}

	public void deleteAtAnyPosition(int pos) {

		Node<Integer> temp = head;
		Node<Integer> perv = null;
		if (head == null) {
			System.out.println("List Is enmpty");
			return;
		}

		if (pos == 0) {
			head = head.next;
			temp.next = null;
			return;
		}

		if (pos < 0) {
			System.out.println("Invalid position! Must be >= 0");
			return;
		}
		
		int countpos = 0;
		while(temp!=null && countpos==pos-1) {
			perv = temp;
			temp=temp.next;
			countpos++;
		}
		
		if(temp==null) {
			System.out.println("Position out of range, no deletion performed");
			return;
		}
		
		perv.next = temp.next;
		temp.next = null;
		System.out.println("Node deleted at position " + pos);

	}

	public void printData() {

		Node<Integer> temp = head;
		while (temp != null) {
			System.out.println("listedlist Data-> " + temp.data);
			temp = temp.next;
		}
	}

	public static void main(String[] args) {

		deleteAtAnyPositionData obj1 = new deleteAtAnyPositionData();
		obj1.insertInToHead(10);
		obj1.insertInToHead(20);
		obj1.insertInToHead(30);
		obj1.insertInToHead(40);
		obj1.printData();
		System.out.println("--------Delete---");
		obj1.deleteAtAnyPosition(0);
		obj1.printData();

	}

}
