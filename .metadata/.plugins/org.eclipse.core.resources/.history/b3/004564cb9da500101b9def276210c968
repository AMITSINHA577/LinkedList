package linkedList;

public class insertAtAnyPos {

	doublyNode<Integer> head; // Pointer to the first node of the list

//	Inserts a new node at the beginning (head) of the doubly linked list.
	private void insertInToHead(int data) {

		doublyNode<Integer> newNode = new doublyNode<Integer>(data);

		// Case 1: If the list is empty
		if (head == null) {
			head = newNode;
			return;
		}

		// Case 2: If list already has nodes
		newNode.next = head;
		head.prev = newNode;
		head = newNode;
	}

//	Inserts a new node at the end (tail) of the doubly linked list.
	private void insertInToTail(int data) {

		doublyNode<Integer> newNode = new doublyNode<Integer>(data);
		// Case 1: Empty list
		if (head == null) {
			head = newNode;
			return;
		}

		// Case 2: Traverse to the last node
		doublyNode<Integer> temp = head;
		while (temp.next != null) {
			temp = temp.next;
		}

		// Connect new node to the end
		temp.next = newNode;
		newNode.prev = temp;

	}

	private void insertAtAnyIndex(int data, int position) {

		doublyNode<Integer> newNode = new doublyNode<Integer>(data); // Node class yaha pe InsertInHead me bani hui use
																		// ho rahi h

		// Case 1: Insert at head
		if (position == 0) {
			insertInToHead(data);
			System.out.println("Inserted at position " + position);
			return;
		}

		doublyNode<Integer> temp = head;
		int currentPos = 0;

		while (temp != null && currentPos < position - 1) {
			temp = temp.next;
			currentPos++;
		}

		if (temp == null) {
			System.out.println("Position out of range");
			return;
		}

		// Case 4: Insert between nodes
		doublyNode<Integer> nextNode = temp.next;
		newNode.next = nextNode;
		newNode.prev = temp;
		temp.next = newNode;
		nextNode.prev = newNode;

		System.out.println("Inserted " + data + " at position " + position);

	}

	private void printData() {
		doublyNode<Integer> temp = head;
		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}

	}

	public static void main(String[] args) {

		insertAtAnyPos list = new insertAtAnyPos();

		System.out.println("Inserting into head...");
		list.insertInToHead(10);
		list.insertInToHead(20);
		list.insertInToHead(30);
		list.insertInToHead(40);

		list.printData();

		System.out.println("Inserting into tail...");
		list.insertInToTail(90);
		list.insertInToTail(100);
		list.printData();

		System.out.println("Insert into any index...");
		list.insertAtAnyIndex(2, 660);
		list.printData();

	}

}