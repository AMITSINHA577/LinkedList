package linkedList;

/**
 * This class demonstrates a complete implementation of a Doubly Linked List
 * with insertion at both the head and the tail.
 */

public class completeDoublyCode {

	DNode<Integer> head; // Pointer to the first node of the list

//	Inserts a new node at the beginning (head) of the doubly linked list.
	private void insertInToHead(int data) {

		DNode<Integer> newNode = new DNode(data);

		if (head == null) {
			head = newNode;
			return;
		}

		newNode.next = head;
		head.prev = newNode;
		head = newNode;
	}

	private void insertInToTail(int data) {

		DNode<Integer> newNode = new DNode(data);
		if (head == null) {
			head = newNode;
			return;
		}

		DNode<Integer> temp = head;
		while (temp.next != null) {
			temp = temp.next;
		}

		temp.next = newNode;
		newNode.prev = temp;

	}

	private void printData() {
		DNode<Integer> temp = head;
		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}

	}

	public static void main(String[] args) {

		completeDoublyCode list = new completeDoublyCode();

		System.out.println("Inserting into head...");
		list.insertInToHead(10);
		list.insertInToHead(20);
		list.insertInToHead(30);
		list.insertInToHead(40);

		list.printData();

		System.out.println("Inserting into tail...");
		list.insertInToTail(90);
		list.insertInToTail(100);
		list.printData();

	}

}

/**
 * DNode represents a single node in the doubly linked list. Each node contains
 * data, a reference to the next node, and a reference to the previous node.
 */

class DNode<T> {
	T data;
	DNode<T> next;
	DNode<T> prev;

	// Default constructor
	public DNode() {
		this.next = null;
		this.prev = null;
	}

	// Parameterized constructor
	public DNode(T data) {
		this.data = data;
		this.next = null;
		this.prev = null;

	}
}
