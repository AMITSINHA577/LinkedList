package LinkedList_30_Q;

import linkedList.reversList;

public class CheckPalindromeLinkedList {

	nodeLinks<Integer> head;

	public void instertData(int data) {
		nodeLinks<Integer> newNodeData = new nodeLinks<Integer>(data);

		if (head == null) {
			head = newNodeData;
			return;
		}

		newNodeData.next = head;
		head = newNodeData;
	}

	public void printData() {
		nodeLinks<Integer> temp = head;

		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}
	}

	public nodeLinks<Integer> findMiddle() {

		if (head == null) {
			System.out.println("list is Empty");
			return null;
		}
		nodeLinks<Integer> firstP = head;
		nodeLinks<Integer> secondP = head;

		while (secondP.next != null && secondP != null) {
			firstP = firstP.next;
			secondP = secondP.next.next;
		}

		System.out.println("this is middle element " + firstP.data);
		return firstP;
	}

	public nodeLinks<Integer> reversLsit() {

		nodeLinks<Integer> prevP = null;
		nodeLinks<Integer> currectP = findMiddle();

		while (currectP != null) {
			nodeLinks<Integer> nextP = currectP.next;
			currectP.next = prevP;
			prevP = currectP;
			currectP = nextP;
		}

		return prevP;
	}

	public boolean isPalindrome() {

		nodeLinks<Integer> leftHead = reversLsit();
		nodeLinks<Integer> temp = head;

		while (leftHead != null) {
			if (temp.data.equals(leftHead.data)) {
				return false;
			}

			leftHead = leftHead.next;
			temp = temp.next;
		}

		return true;

	}

	public static void main(String[] args) {

		CheckPalindromeLinkedList obj1 = new CheckPalindromeLinkedList();
		obj1.instertData(10);
		obj1.instertData(20);
		obj1.instertData(30);
		obj1.instertData(20);
		obj1.instertData(10);

		obj1.printData();
		obj1.findMiddle();
		System.out.println(obj1.isPalindrome());

	}

}
