package Recursoin;

import java.util.ArrayList;
import java.util.List;

public class SubsetsArrayRecursoin {

	void printSubsets(int arr[], List<Integer> subset, int index) {

		// Step 1: Base Case
		if (index == arr.length) {
			System.out.println(subset);
			return;
		}

		// Step 2: INCLUDE element
		subset.add(arr[index]);

		// Step 3: Recursive call for include
		printSubsets(arr, subset, index + 1);

		// Step 4: BACKTRACK (undo include)
		subset.remove(subset.size() - 1);

		// Step 5: EXCLUDE element
		printSubsets(arr, subset, index + 1);
	}

	public static void main(String[] args) {

		SubsetsArrayRecursoin obj = new SubsetsArrayRecursoin();

		int arr[] = {};

		List<Integer> subset = new ArrayList<>();

		obj.printSubsets(arr, subset, 0);
	}
}
