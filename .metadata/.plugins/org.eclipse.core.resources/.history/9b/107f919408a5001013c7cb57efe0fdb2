package linkedList;

public class completeDoublyCode {

	DNode<Integer> head;

	private void insertInToHead(int data) {

		DNode<Integer> newNode = new DNode(data);

		if (head == null) {
			head = newNode;
			return;
		}

		newNode.next = head;
		head.prev = newNode;
		head = newNode;
	}

	private void insertInToTail(int data) {

		DNode<Integer> newNode = new DNode(data);
		if (head == null) {
			head = newNode;
			return;
		}

		DNode<Integer> temp = head;
		while (temp != null) {
			temp = temp.next;
		}

		temp.next = newNode.next;
		newNode.prev = temp;

	}

	private void printData() {
		DNode<Integer> temp = head;
		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}

	}

	public static void main(String[] args) {

		completeDoublyCode list = new completeDoublyCode();
		list.insertInToHead(10);
		list.insertInToHead(20);
		list.insertInToHead(30);
		list.insertInToHead(40);
		list.printData();
		System.out.println("insert in to tail...");
		list.insertInToTail(90);
		list.printData();

	}

}

class DNode<T> {
	T data;
	DNode<T> next;
	DNode<T> prev;

	public DNode() {
		this.next = null;
		this.prev = null;
	}

	public DNode(T data) {
		this.data = data;
		this.next = null;
		this.prev = null;

	}
}
