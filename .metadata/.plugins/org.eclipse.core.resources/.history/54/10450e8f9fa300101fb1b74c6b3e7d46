package linkedList;

public class updateNodeData {

	Node<Integer> head;

	// Insert at the head of the list
	public void insertHead(int data) {

		Node<Integer> newNode = new Node<Integer>(data);
		if (head == null) {
			head = newNode;
//			System.out.println("Insert at head successfully");
			return;
		}

		newNode.next = head;
		head = newNode;
//		System.out.println("Insert at head successfully");

	}

	public void updateData(int pos, int updateDataValue) {
		// TODO Auto-generated method stub

		if (head == null) {
			System.out.println("linkedList is empty");
			return;
		}

		Node<Integer> temp = head;
		int CurrentPos = 1;
		while (temp != null && CurrentPos < pos) {
			CurrentPos++;
			temp = temp.next;
		}

		if (temp != null && CurrentPos == pos) {
			temp.data = updateDataValue;
		} else {
			System.out.println("size is not perfict" + pos);
			return;
		}
		System.out.println("update successfull");

	}

	public void printListedlist() {
		Node<Integer> temp = head;
		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}
	}

	public static void main(String[] args) {

		updateNodeData obj1 = new updateNodeData();
		obj1.insertHead(10);
		obj1.insertHead(20);
		obj1.insertHead(30);
		obj1.insertHead(40);
		obj1.printListedlist();
		System.out.println("update-----------");
		obj1.updateData(2, 70);
		obj1.printListedlist();

	}

}
