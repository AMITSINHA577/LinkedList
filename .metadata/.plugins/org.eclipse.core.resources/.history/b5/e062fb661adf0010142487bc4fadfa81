package LinkedList_30_Q;

public class CreateAndPrintLinkedList {

	nodeLinks<Integer> head;

	public void createAndPrint(int data) {
		nodeLinks<Integer> newNodeData = new nodeLinks<Integer>(data);

		if (head == null) {
			head = newNodeData;
			return;
		}

		newNodeData.next = head;
		head = newNodeData;
	}

	public void printData() {
		nodeLinks<Integer> temp = head;
		while (temp != null) {
			System.out.println(temp.data);
			temp = temp.next;
		}
	}

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		CreateAndPrintLinkedList obj1 = new CreateAndPrintLinkedList();
		obj1.createAndPrint(10);
		obj1.printData();
		System.out.println("------------------------");
		obj1.createAndPrint(70);
		obj1.createAndPrint(30);
		obj1.createAndPrint(50);
		obj1.printData();

	}

}
