package LinkedList_30_Q;

public class ReverseLinkedListIterative {
	
	nodeLinks<Integer> head ;
	
	public nodeLinks<Integer> reverseIterative() {
		nodeLinks currectN = head;
		nodeLinks preN = null;
		
		while(currectN != null) {
			
			nodeLinks nextN = currectN.next;
			currectN.next = preN;
			preN = currectN;
			currectN = nextN;
			
		}
		
		head = preN;
		return head;
	}

