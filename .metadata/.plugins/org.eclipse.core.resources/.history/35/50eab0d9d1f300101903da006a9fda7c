package Recursoin;

public class BinarySearchRecursion {

	public int binarySearch(int arr, int target, int start, int end) {
		
		if(start<=end) {
			int mid = (start+end)/2;
			if(arr[mid]==target) {
				return mid;
			}
			
			if(arr[mid]<=target) {
				return arr, target, start=mid+1, end;
			}
			
			if(arr[mid]>=target) {
				return arr, target, start, end-1;
			}
		}
		return -1;
	}

